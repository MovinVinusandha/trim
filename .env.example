# 1. NGINX SUBDOMAIN ROUTING (No http:// or ports)
API_DOMAIN_NAME=api.trim.movinvinusandha.me
APP_DOMAIN_NAME=app.trim.movinvinusandha.me
ROOT_DOMAIN_NAME=trim.movinvinusandha.me

# 2. BACKEND CONFIGURATION (Spring Boot)
# Used by Spring to generate the short links
ROOT_DOMAIN_URL=https://trim.movinvinusandha.me

# Used by Spring Security CORS to allow your React app to log in
APP_DOMAIN_URL=https://app.trim.movinvinusandha.me

# 3. FRONTEND CONFIGURATION (Vite/React)
# Used by Axios to send requests to Spring Boot
VITE_API_BASE_URL=https://api.trim.movinvinusandha.me

# Used by the UI to display the gray "trim.movinvinusandha.me/" prefix box
VITE_ROOT_DOMAIN=https://trim.movinvinusandha.me

# 4. DATABASE SETTINGS (MySQL)
MYSQL_ROOT_PASSWORD=GENERATED_STRONG_PASSWORD_HERE
MYSQL_DATABASE=url_shortener
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/url_shortener?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=GENERATED_STRONG_PASSWORD_HERE

# 5. CACHING SETTINGS (Redis)
REDIS_HOST=redis
REDIS_PORT=6379

# 6. SECURITY & AUTHENTICATION
# Run `openssl rand -base64 32` in your terminal to get a great key for this
JWT_SECRET=GENERATED_SECURE_256_BIT_KEY_HERE
ROOT_USER_EMAIL=admin@trim.movinvinusandha.me
ROOT_USER_PASSWORD=GENERATED_STRONG_ADMIN_PASSWORD